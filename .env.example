# Configurações de Ambiente para o Polymarket BTC 5M Trading Bot

# Modo de Execução: 'live' (Real na Polygon via CLOB V2) ou 'paper' (Simulação)
EXECUTION_MODE=live

# Chave Privada da Carteira Signer na Polygon (NUNCA compartilhe e NUNCA suba para o GitHub!)
POLYGON_PRIVATE_KEY=sua_chave_privada_aqui

# Endereços oficiais da sua conta Polymarket (Proxy Safe 1271)
POLY_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
POLY_FUNDER_ADDRESS=0x0000000000000000000000000000000000000000

# Credenciais de API Polymarket CLOB (geradas automaticamente via L1/L2 signature)
POLYMARKET_API_KEY=sua_api_key_aqui
POLYMARKET_API_SECRET=seu_api_secret_aqui
POLYMARKET_API_PASSPHRASE=sua_passphrase_aqui
